{
  "name": "@codefuturist/email-mcp",
  "version": "0.5.1",
  "mcpName": "io.github.codefuturist/email-mcp",
  "description": "Email MCP server with IMAP + SMTP support",
  "type": "module",
  "bin": {
    "email-mcp": "dist/main.js"
  },
  "main": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "smoke": "tsx scripts/e2e-smoke.mts",
    "test:all": "vitest run && vitest run --config vitest.config.integration.ts",
    "check": "biome check src/",
    "report": "mkdir -p reports && biome check src/ --reporter=json > reports/biome.json 2>&1; actionlint -format '{{json .}}' > reports/actionlint.json 2>&1; pnpm test",
    "commit": "cog commit",
    "changelog": "cog changelog",
    "version:check": "cog check",
    "version:bump": "cog bump --auto",
    "version:bump:minor": "cog bump --minor",
    "version:bump:patch": "cog bump --patch",
    "version:log": "cog log",
    "prepare": "lefthook install || true",
    "hooks:install": "lefthook install --force",
    "hooks:uninstall": "lefthook uninstall",
    "docker:build": "docker build -t codefuturist/email-mcp .",
    "docker:run": "docker run --rm -i -v ~/.config/email-mcp:/home/node/.config/email-mcp:ro codefuturist/email-mcp",
    "docker:compose": "docker compose up",
    "docker:clean": "docker images --format '{{.Repository}}:{{.Tag}}' | grep email-mcp | xargs docker rmi -f 2>/dev/null; true",
    "docker:prune": "docker image prune -f && docker buildx prune -f",
    "release:check": "goreleaser check",
    "release:snapshot": "goreleaser release --snapshot --clean && pnpm docker:clean",
    "release:dry-run": "goreleaser release --skip=publish --clean && pnpm docker:clean",
    "prepublishOnly": "tsc -p tsconfig.build.json",
    "build:binary": "bun build --compile --minify --bytecode src/main.ts --outfile build/email-mcp",
    "build:binaries": "bash scripts/build-binaries.sh",
    "scan": "pnpm run scan:audit && pnpm run scan:semgrep && pnpm run scan:trivy",
    "scan:audit": "pnpm audit --audit-level=high",
    "scan:semgrep": "semgrep --metrics=off --error --config p/security-audit --config p/secrets --config p/typescript --config p/javascript --config p/nodejs src/",
    "scan:trivy": "trivy fs . --scanners vuln,secret,misconfig --skip-dirs node_modules --skip-dirs build --skip-dirs reports --severity HIGH,CRITICAL --exit-code 1 --quiet",
    "knip": "knip"
  },
  "keywords": [
    "email",
    "mcp",
    "imap",
    "smtp",
    "model-context-protocol",
    "mcp-server",
    "claude",
    "anthropic",
    "ai-tools",
    "llm",
    "nodejs"
  ],
  "author": {
    "name": "codefuturist",
    "url": "https://github.com/codefuturist"
  },
  "license": "LGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codefuturist/email-mcp.git"
  },
  "homepage": "https://github.com/codefuturist/email-mcp#readme",
  "bugs": {
    "url": "https://github.com/codefuturist/email-mcp/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "imapflow": "^2.3.0",
    "libmime": "^5.4.7",
    "node-ical": "^0.27.3",
    "nodemailer": "^10.0.16",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^5.0.3",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "testcontainers": "^12.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
